# /etc/systemd/system/stellenschraube.service
[Unit]
Description=stellenschraube Vorschau-Generator
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/stellenschraube/generator
EnvironmentFile=/opt/stellenschraube/generator/.env
ExecStart=/opt/stellenschraube/generator/venv/bin/gunicorn -w 2 -b 127.0.0.1:5050 --timeout 60 app:app
Restart=always

[Install]
WantedBy=multi-user.target
