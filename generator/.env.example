# Optional: Fragen von Claude statt aus Vorlagen (console.anthropic.com)
ANTHROPIC_API_KEY=
# Schützt /intern – Aufruf dann mit /intern?key=DEIN_TOKEN
INTERN_TOKEN=bitte-aendern
# Speicherort der Datenbank
DB_PATH=/opt/stellenschraube/data/stellenschraube.sqlite3
PREVIEWS_PER_HOUR=20
# Öffentliche Adresse für die Links in den Mails
PUBLIC_URL=https://stellenschraube.ch
# Für das JPG: "chrome" (lokal) oder leer lassen (Chromium von playwright install)
PLAYWRIGHT_CHANNEL=
